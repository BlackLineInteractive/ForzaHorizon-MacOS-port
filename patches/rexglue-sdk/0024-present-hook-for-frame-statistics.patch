+// Called after each frame handed to the presenter (frames skipped for async
+// placeholder pipelines are not), for an app's frame statistics; set through
+// rexgpu_set_present_hook, which the app finds with dlsym.
+static std::atomic<void (*)()> rexgpu_present_hook{nullptr};
+extern "C" __attribute__((visibility("default"))) void rexgpu_set_present_hook(void (*hook)()) {
+  rexgpu_present_hook.store(hook, std::memory_order_release);
+}

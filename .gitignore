# ==============================================================================
# Forza Horizon (Xbox 360 PC/macOS Port) - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Game Media, ROMs, Packages & Proprietary Assets (Copyright / DMCA)
# ------------------------------------------------------------------------------
/rom/
/extracted/
/extracted*/
/dump/
/assets/

*.xex
*.iso
*.img
*.pkg
*.zip
*.bik
*.pck
*.bank
*.spa
*.bin.be

# ------------------------------------------------------------------------------
# 2. Codegen & Static Recompilation Outputs
# ------------------------------------------------------------------------------
# Codegen output lives in private generated repos; only rexglue.cmake is tracked
forza-recomp/generated/*
!forza-recomp/generated/rexglue.cmake
forza-recomp/codegen-warnings.log
codegen-warnings.log

# ------------------------------------------------------------------------------
# 3. Reverse Engineering Databases & Tooling (Ghidra, IDA, Radare2)
# ------------------------------------------------------------------------------
/ghidra/
/ghidra_projects/
*.gpr
*.rep/
*.idb
*.i64
*.nam
*.til
*.id0
*.id1
*.id2
*.r2

# Disassembly & export logs
*.log

# ------------------------------------------------------------------------------
# 4. Emulator Dumps, Caches & Server Data
# ------------------------------------------------------------------------------
# Runtime shader dumps and caches (metal_shaders/*.metal sources are tracked)
/shaders/
/shader_cache/
*.spv
*.dxbc
# Compiled Metal shaders: rebuilt by tools/spirv_to_metal.py --metallib
*.air
*.metallib
# Metal frame captures (Xcode) and CPU profiler output (src/debug/cpu_profile.cpp)
*.gputrace
cpuprof.txt
# Guest frame dumps (FORZA_SCREENSHOT / FORZA_FRAMEDUMP_DIR)
forza_shot_*.ppm

# Forza Live server data and runtime profiles
forza_live_data/
/user/
/savedata/
/captures/
screenshots/
/screenshots/

# ------------------------------------------------------------------------------
# 5. Build & Compiler Artifacts (C/C++ / CMake / Clang / Ninja)
# ------------------------------------------------------------------------------
forza-recomp/out/
/build/
/build-*/
/cmake-build-*/
/bin/
/out/
/dist/
tools/unxmem

# Compiled object files and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.dSYM/

# LSP & tooling cache
compile_commands.json
/.cache/
.cache/
CMakeUserPresets.json

# ------------------------------------------------------------------------------
# 6. Scripting & Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
.env

# ------------------------------------------------------------------------------
# 7. OS & System Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# Xcode (Metal debugging, Instruments)
xcuserdata/
DerivedData/
*.xcscmblueprint
*.trace/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Local UI configs
imgui.ini
*.ini

# ------------------------------------------------------------------------------
# 8. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
*.iml

# Shared editor configs are tracked; settings.json holds machine paths (cmake.sourceDirectory)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code: the shared settings.json is tracked, settings.local.json is personal
.claude/*
!.claude/settings.json

*.swp
*.swo
*~
\#*\#

# ------------------------------------------------------------------------------
# 9. Temporary & Crash Dumps
# ------------------------------------------------------------------------------
/tmp/
/temp/
*.tmp
*.bak
*.dmp
*.core
